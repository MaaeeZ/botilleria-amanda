# ==============================================================================
# CONFIGURACIÓN DE CORREO SMTP Y CIERRE DE CAJA - BOTILLERÍA AMANDA
# ==============================================================================

# Servidor SMTP (por ejemplo: smtp.gmail.com para Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# Credenciales de envío (Para Gmail, usa tu correo y una "Contraseña de Aplicación" de 16 caracteres)
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_contrasena_de_aplicacion

# Correo destinatario que recibirá el reporte diario de cierre de caja
CIERRE_DESTINATARIO=administrador@botilleriaamanda.cl

# Hora automática para el cierre diario en formato 24h (HH:mm)
CIERRE_HORA_AUTO=23:00

# ==============================================================================
# ASISTENTE IA GOOGLE GEMINI (Opcional si se configura desde la app)
# ==============================================================================
# Obtén tu clave gratuita en: https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
